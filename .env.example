# Register an app at https://developer.kroger.com to get these.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Must exactly match a redirect URI registered on your Kroger app (needed for cart/profile).
KROGER_REDIRECT_URI=http://localhost:8000/callback

# Optional: "prod" (default) or "cert" for Kroger's certification environment.
KROGER_ENV=prod

# Optional: default store for prices/stock when no preferred location has been set.
KROGER_LOCATION_ID=

# Optional: where tokens and preferences are stored (default: ~/.config/kroger-mcp).
KROGER_MCP_DATA_DIR=
