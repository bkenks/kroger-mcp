# Optional. `kroger-mcp setup` is the recommended way to add credentials (stored privately in
# ~/.config/kroger-mcp). Values set here or in the environment take precedence over that file.
# Get them from your app at https://developer.kroger.com.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Must exactly match a redirect URI registered on your Kroger app (needed for cart/profile).
KROGER_REDIRECT_URI=http://localhost:8000/callback

# Optional: "prod" (default) or "cert" for Kroger's certification environment.
KROGER_ENV=prod

# Optional: default store for prices/stock when no preferred location has been set.
KROGER_LOCATION_ID=

# Optional: where tokens and preferences are stored (default: ~/.config/kroger-mcp).
KROGER_MCP_DATA_DIR=

# --- Remote mode only (`kroger-mcp serve`) -------------------------------------
# Public HTTPS origin clients connect to (no path). The MCP endpoint is $MCP_PUBLIC_URL/mcp and
# $MCP_PUBLIC_URL/kroger/callback must ALSO be registered as a redirect URI on your Kroger app.
MCP_PUBLIC_URL=

# Listen address/port (defaults 127.0.0.1:3000; PORT is honored too for PaaS hosts).
MCP_HOST=
MCP_PORT=

# Kroger account allowed to sign in (see `kroger-mcp status`). Defaults to the owner of the saved login.
KROGER_ALLOWED_PROFILE_ID=

# Optional static bearer token for scripts/curl, in addition to OAuth. Generate: openssl rand -hex 32
MCP_API_KEY=

# Optional: reverse-proxy trust (default trusts loopback/private networks) and extra allowed Host headers.
MCP_TRUST_PROXY=
MCP_ALLOWED_HOSTS=
